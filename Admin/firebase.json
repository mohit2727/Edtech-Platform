{
  "hosting": [
    {
      "site": "physical-education-with-ravina-admin",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/dashboard/courses/**",
          "destination": "/dashboard/courses/id/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}